#:import dp kivy.metrics.dp

<Card@BoxLayout>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: dp(15)
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.28
        RoundedRectangle:
            pos: self.x, self.y - dp(4)
            size: self.width, self.height
            radius: [dp(20)]
        Color:
            rgba: 0.13, 0.09, 0.21, 0.94
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18)]
    canvas.after:
        Color:
            rgba: 0.55, 0.36, 0.68, 0.45
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(18))
            width: dp(1)

<SectionLabel@Label>:
    size_hint_y: None
    height: dp(22)
    font_size: dp(12)
    bold: True
    color: 0.98, 0.62, 0.79, 1
    halign: "left"
    valign: "middle"
    text_size: self.size

<FieldInput@TextInput>:
    multiline: False
    font_size: dp(14)
    size_hint_y: None
    height: dp(46)
    padding: dp(12), dp(12)
    background_normal: ""
    background_active: ""
    background_color: 0.10, 0.07, 0.16, 1
    foreground_color: 0.97, 0.94, 0.99, 1
    cursor_color: 0.96, 0.45, 0.71, 1
    hint_text_color: 0.56, 0.48, 0.66, 1
    selection_color: 0.96, 0.45, 0.71, 0.45

<DarkSpinner@Spinner>:
    size_hint_y: None
    height: dp(46)
    font_size: dp(14)
    background_normal: ""
    background_color: 0.10, 0.07, 0.16, 1
    color: 0.97, 0.94, 0.99, 1

<PrimaryButton@Button>:
    size_hint_y: None
    height: dp(44)
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    font_size: dp(14)
    bold: True
    opacity: 0.5 if self.disabled else 1
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.25
        RoundedRectangle:
            pos: self.x, self.y - dp(2)
            size: self.size
            radius: [self.height / 2]
        Color:
            rgba: 0.96, 0.45, 0.71, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]

<GhostButton@Button>:
    size_hint_y: None
    height: dp(42)
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 0.95, 0.89, 0.99, 1
    font_size: dp(13)
    opacity: 0.5 if self.disabled else 1
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.22
        RoundedRectangle:
            pos: self.x, self.y - dp(2)
            size: self.size
            radius: [self.height / 2]
        Color:
            rgba: 0.24, 0.17, 0.36, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]
    canvas.after:
        Color:
            rgba: 0.62, 0.42, 0.78, 0.45
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, self.height / 2)
            width: dp(1)

<SoftProgress>:
    size_hint_y: None
    height: dp(10)
    canvas:
        Color:
            rgba: 0.19, 0.13, 0.29, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]
        Color:
            rgba: 0.96, 0.45, 0.71, 1
        RoundedRectangle:
            pos: self.pos
            size: ((self.width * self.value / 100.0) if self.value > 0 else 0, self.height)
            radius: [self.height / 2]

<SoftCheck>:
    size_hint: None, None
    size: dp(24), dp(24)
    canvas:
        Color:
            rgba: (0.96, 0.45, 0.71, 1) if self.active else (0.18, 0.13, 0.27, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(7)]
        Color:
            rgba: (1, 1, 1, 1) if self.active else (0, 0, 0, 0)
        Line:
            points: [self.x + dp(6), self.y + self.height * 0.52, self.x + self.width * 0.43, self.y + dp(5), self.x + self.width - dp(5), self.y + self.height - dp(6)]
            width: dp(2)

<StatusLabel@Label>:
    size_hint_y: None
    height: dp(38)
    font_size: dp(12)
    color: 0.80, 0.73, 0.90, 1
    halign: "left"
    valign: "middle"
    text_size: self.size

<RootWidget>:
    Image:
        source: "bg_gradient.png"
        size_hint: None, None
        size: root.size
        pos: root.pos
        fit_mode: "fill"

    Image:
        id: bg_glow
        source: "glow_pink.png"
        size_hint: None, None
        size: dp(360), dp(360)
        pos: root.width - dp(320), root.height - dp(330)
        opacity: 0.35
        fit_mode: "contain"

    BoxLayout:
        orientation: "vertical"
        size: root.size
        pos: root.pos

        FloatLayout:
            id: header
            size_hint_y: None
            height: dp(84)
            canvas.after:
                Color:
                    rgba: 0, 0, 0, 0.30
                Rectangle:
                    pos: self.x, self.y - dp(3)
                    size: self.width, dp(6)
            Image:
                source: "header_gradient.png"
                size_hint: None, None
                size: header.size
                pos: header.pos
                fit_mode: "fill"
            BoxLayout:
                size: header.size
                pos: header.pos
                padding: dp(16), dp(8), dp(80), dp(8)
                orientation: "vertical"
                Label:
                    text: "万能视频下载器"
                    font_size: dp(21)
                    bold: True
                    color: 1, 1, 1, 1
                    halign: "left"
                    valign: "middle"
                    text_size: self.size
                Label:
                    text: "yt-dlp 引擎 · 一千多个站点 · 小真寻帮你收好视频"
                    font_size: dp(11)
                    color: 1, 0.94, 0.98, 1
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

        ScrollView:
            id: main_scroll
            do_scroll_x: False
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: dp(12)
                spacing: dp(10)

                Card:
                    SectionLabel:
                        text: "视频链接"
                    FieldInput:
                        id: url_input
                        hint_text: "粘贴 YouTube / B站 / X / TikTok 等任意视频链接"
                    BoxLayout:
                        size_hint_y: None
                        height: dp(44)
                        spacing: dp(8)
                        GhostButton:
                            text: "粘贴"
                            height: dp(40)
                            on_release: app.paste_url()
                        GhostButton:
                            text: "清空"
                            height: dp(40)
                            on_release: app.clear_url()
                        PrimaryButton:
                            text: "解析"
                            height: dp(40)
                            on_release: app.parse_url()

                Card:
                    SectionLabel:
                        text: "按标题搜索（B站 / YouTube）"
                    FieldInput:
                        id: search_platform_input
                        hint_text: "平台（B站 / 哔哩哔哩 / 油管 / YouTube）"
                    FieldInput:
                        id: search_title_input
                        hint_text: "视频标题（不区分大小写）"
                    BoxLayout:
                        size_hint_y: None
                        height: dp(44)
                        spacing: dp(8)
                        PrimaryButton:
                            text: "搜索"
                            height: dp(44)
                            on_release: app.search_by_title()
                    Label:
                        text: app.search_status
                        size_hint_y: None
                        height: (dp(34) if app.search_status else 0)
                        opacity: 1 if app.search_status else 0
                        font_size: dp(11)
                        color: 0.78, 0.70, 0.88, 1
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                Card:
                    BoxLayout:
                        size_hint_y: None
                        height: dp(26)
                        Label:
                            text: "视频列表"
                            font_size: dp(12)
                            bold: True
                            color: 0.98, 0.62, 0.79, 1
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
                        Label:
                            text: app.list_summary
                            font_size: dp(11)
                            color: 0.98, 0.62, 0.79, 1
                            halign: "right"
                            valign: "middle"
                            text_size: self.size
                    ScrollView:
                        size_hint_y: None
                        height: dp(190)
                        do_scroll_x: False
                        BoxLayout:
                            id: list_container
                            orientation: "vertical"
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(2)
                    BoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(8)
                        GhostButton:
                            text: "全选"
                            height: dp(40)
                            on_release: app.select_all(True)
                        GhostButton:
                            text: "取消全选"
                            height: dp(40)
                            on_release: app.select_all(False)

                Card:
                    SectionLabel:
                        text: "下载设置"
                    BoxLayout:
                        size_hint_y: None
                        height: dp(46)
                        spacing: dp(10)
                        Label:
                            text: "画质"
                            size_hint_x: None
                            width: dp(44)
                            font_size: dp(13)
                            color: 0.86, 0.78, 0.93, 1
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
                        DarkSpinner:
                            id: quality_spinner
                            text: "最佳画质（自动）"
                            values: ["最佳画质（自动）", "1080p 及以下", "720p 及以下", "仅音频"]
                    BoxLayout:
                        size_hint_y: None
                        height: dp(34)
                        spacing: dp(6)
                        AnchorLayout:
                            size_hint_x: None
                            width: dp(36)
                            anchor_x: "center"
                            anchor_y: "center"
                            SoftCheck:
                                active: app.use_service
                                on_active: app.set_use_service(self.active)
                        Label:
                            text: "使用前台服务下载（可退出 App 继续）"
                            font_size: dp(12)
                            color: 0.86, 0.78, 0.93, 1
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
                    GhostButton:
                        text: ("收起登录 / cookies" if app.login_expanded else "登录 / cookies（可选）")
                        height: dp(40)
                        on_release: app.toggle_login_section()
                    BoxLayout:
                        orientation: "vertical"
                        size_hint_y: None
                        height: (dp(116) if app.login_expanded else 0)
                        opacity: 1 if app.login_expanded else 0
                        disabled: not app.login_expanded
                        spacing: dp(6)
                        Label:
                            text: "登录在站点官方页面完成，App 不接触账号密码；cookies 只保存在本机，不会上传。需要登录的视频，不登录将无法下载。"
                            font_size: dp(11)
                            color: 0.78, 0.70, 0.88, 1
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
                            size_hint_y: None
                            height: dp(58)
                        BoxLayout:
                            size_hint_y: None
                            height: dp(44)
                            spacing: dp(8)
                            GhostButton:
                                text: "站内登录"
                                height: dp(44)
                                on_release: app.open_login_webview()
                            GhostButton:
                                text: "导入 cookies.txt"
                                height: dp(44)
                                on_release: app.show_cookies_dialog()
                    Label:
                        text: app.login_notice
                        size_hint_y: None
                        height: (dp(34) if app.login_notice else 0)
                        opacity: 1 if app.login_notice else 0
                        font_size: dp(11)
                        color: 0.95, 0.75, 0.4, 1
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                Card:
                    BoxLayout:
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(8)
                        PrimaryButton:
                            text: "下载选中"
                            on_release: app.start_download()
                        GhostButton:
                            text: "取消"
                            disabled: not app.busy
                            on_release: app.cancel_download()
                    SoftProgress:
                        value: app.progress
                    Label:
                        text: app.progress_detail
                        size_hint_y: None
                        height: (dp(24) if app.progress_detail else 0)
                        opacity: 1 if app.progress_detail else 0
                        font_size: dp(11)
                        color: 0.82, 0.75, 0.91, 1
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                    StatusLabel:
                        text: app.status
                    BoxLayout:
                        size_hint_y: None
                        height: dp(38)
                        spacing: dp(8)
                        Label:
                            text: "保存目录：" + app.download_dir_text
                            font_size: dp(11)
                            color: 0.78, 0.70, 0.88, 1
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
                            shorten: True
                            shorten_from: "center"
                        GhostButton:
                            text: "更改"
                            size_hint_x: None
                            width: dp(64)
                            height: dp(38)
                            on_release: app.choose_download_dir()
                    BoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(8)
                        GhostButton:
                            text: "存储权限"
                            height: dp(40)
                            on_release: app.open_storage_settings()
                        GhostButton:
                            text: "服务日志"
                            height: dp(40)
                            on_release: app.show_service_log()
                        GhostButton:
                            text: "刷新目录"
                            height: dp(40)
                            on_release: app.refresh_download_dir()
                    BoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(8)
                        GhostButton:
                            text: "悬浮嗅探"
                            size_hint_x: None
                            width: dp(92)
                            height: dp(40)
                            on_release: app.toggle_sniffer()
                        Label:
                            text: app.sniffer_status
                            font_size: dp(11)
                            color: 0.78, 0.70, 0.88, 1
                            halign: "left"
                            valign: "middle"
                            text_size: self.size

                Card:
                    SectionLabel:
                        text: "日志"
                    ScrollView:
                        id: log_scroll
                        size_hint_y: None
                        height: dp(190)
                        do_scroll_x: False
                        Label:
                            text: app.log_text
                            size_hint_y: None
                            height: self.texture_size[1]
                            text_size: self.width, None
                            font_size: dp(11)
                            color: 0.82, 0.75, 0.91, 1
                            halign: "left"
                            valign: "top"
                    GhostButton:
                        text: "复制日志"
                        height: dp(36)
                        on_release: app.copy_log()

    Image:
        id: mascot_glow
        source: "glow_pink.png"
        size_hint: None, None
        size: dp(84), dp(84)
        pos: root.width - dp(86), root.height - dp(98) + app.mascot_bob
        opacity: 0.45
        fit_mode: "contain"

    Image:
        id: mascot_image
        source: "mascot.png"
        size_hint: None, None
        size: dp(56), dp(56)
        pos: root.width - dp(72), root.height - dp(84) + app.mascot_bob
        fit_mode: "contain"
