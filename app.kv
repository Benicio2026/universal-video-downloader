#:import dp kivy.metrics.dp

<Card@BoxLayout>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: dp(14)
    spacing: dp(9)
    canvas.before:
        Color:
            rgba: 0.118, 0.161, 0.231, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]

<SectionLabel@Label>:
    size_hint_y: None
    height: dp(22)
    font_size: dp(12)
    bold: True
    color: 0.58, 0.64, 0.75, 1
    halign: "left"
    valign: "middle"
    text_size: self.size

<FieldInput@TextInput>:
    multiline: False
    font_size: dp(14)
    size_hint_y: None
    height: dp(46)
    padding: dp(12), dp(12)
    background_normal: ""
    background_active: ""
    background_color: 0.059, 0.09, 0.165, 1
    foreground_color: 0.9, 0.93, 0.98, 1
    cursor_color: 0.23, 0.51, 0.96, 1
    hint_text_color: 0.45, 0.51, 0.62, 1
    selection_color: 0.23, 0.51, 0.96, 0.45

<DarkSpinner@Spinner>:
    size_hint_y: None
    height: dp(46)
    font_size: dp(14)
    background_normal: ""
    background_color: 0.059, 0.09, 0.165, 1
    color: 0.9, 0.93, 0.98, 1

<PrimaryButton@Button>:
    size_hint_y: None
    height: dp(46)
    background_normal: ""
    background_color: 0.23, 0.51, 0.96, 1
    color: 1, 1, 1, 1
    font_size: dp(15)
    bold: True

<GhostButton@Button>:
    size_hint_y: None
    height: dp(42)
    background_normal: ""
    background_color: 0.16, 0.22, 0.32, 1
    color: 0.85, 0.89, 0.96, 1
    font_size: dp(14)

<StatusLabel@Label>:
    size_hint_y: None
    height: dp(38)
    font_size: dp(12)
    color: 0.7, 0.76, 0.86, 1
    halign: "left"
    valign: "middle"
    text_size: self.size

<RootWidget>:
    orientation: "vertical"
    canvas.before:
        Color:
            rgba: 0.059, 0.09, 0.165, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        size_hint_y: None
        height: dp(68)
        padding: dp(16), dp(8)
        spacing: dp(8)
        canvas.before:
            Color:
                rgba: 0.118, 0.435, 0.922, 1
            Rectangle:
                pos: self.pos
                size: self.size
        canvas.after:
            Color:
                rgba: 0.95, 0.65, 0.78, 1
            Rectangle:
                pos: self.x, self.y
                size: self.width, dp(2)
        BoxLayout:
            orientation: "vertical"
            Label:
                text: "万能视频下载器"
                font_size: dp(21)
                bold: True
                color: 1, 1, 1, 1
                halign: "left"
                valign: "middle"
                text_size: self.size
            Label:
                text: "yt-dlp 引擎 · 一千多个站点 · 小真寻帮你收好视频"
                font_size: dp(11)
                color: 0.95, 0.9, 0.95, 1
                halign: "left"
                valign: "middle"
                text_size: self.size
        Image:
            source: "mascot.png"
            size_hint_x: None
            width: dp(52)
            size_hint_y: None
            height: dp(52)
            allow_stretch: True
            keep_ratio: True

    ScrollView:
        id: main_scroll
        do_scroll_x: False
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            padding: dp(12)
            spacing: dp(10)

            Card:
                SectionLabel:
                    text: "视频链接"
                FieldInput:
                    id: url_input
                    hint_text: "粘贴 YouTube / B站 / X / TikTok 等任意视频链接"
                BoxLayout:
                    size_hint_y: None
                    height: dp(44)
                    spacing: dp(8)
                    GhostButton:
                        text: "粘贴"
                        height: dp(40)
                        on_release: app.paste_url()
                    GhostButton:
                        text: "清空"
                        height: dp(40)
                        on_release: app.clear_url()
                    PrimaryButton:
                        text: "解析"
                        height: dp(40)
                        on_release: app.parse_url()

            Card:
                BoxLayout:
                    size_hint_y: None
                    height: dp(26)
                    Label:
                        text: "视频列表"
                        font_size: dp(12)
                        bold: True
                        color: 0.58, 0.64, 0.75, 1
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                    Label:
                        text: app.list_summary
                        font_size: dp(11)
                        color: 0.58, 0.64, 0.75, 1
                        halign: "right"
                        valign: "middle"
                        text_size: self.size
                ScrollView:
                    size_hint_y: None
                    height: dp(190)
                    do_scroll_x: False
                    BoxLayout:
                        id: list_container
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(2)
                BoxLayout:
                    size_hint_y: None
                    height: dp(40)
                    spacing: dp(8)
                    GhostButton:
                        text: "全选"
                        height: dp(40)
                        on_release: app.select_all(True)
                    GhostButton:
                        text: "取消全选"
                        height: dp(40)
                        on_release: app.select_all(False)

            Card:
                SectionLabel:
                    text: "下载设置"
                BoxLayout:
                    size_hint_y: None
                    height: dp(46)
                    spacing: dp(10)
                    Label:
                        text: "画质"
                        size_hint_x: None
                        width: dp(44)
                        font_size: dp(13)
                        color: 0.75, 0.8, 0.88, 1
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                    DarkSpinner:
                        id: quality_spinner
                        text: "最佳画质（自动）"
                        values: ["最佳画质（自动）", "1080p 及以下", "720p 及以下", "仅音频"]
                BoxLayout:
                    size_hint_y: None
                    height: dp(34)
                    spacing: dp(6)
                    CheckBox:
                        size_hint_x: None
                        width: dp(34)
                        active: app.use_service
                        on_active: app.set_use_service(self.active)
                    Label:
                        text: "使用前台服务下载（可退出 App 继续）"
                        font_size: dp(12)
                        color: 0.75, 0.8, 0.88, 1
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                GhostButton:
                    text: ("收起登录 / cookies" if app.login_expanded else "登录 / cookies（可选）")
                    height: dp(40)
                    on_release: app.toggle_login_section()
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: (dp(116) if app.login_expanded else 0)
                    opacity: 1 if app.login_expanded else 0
                    disabled: not app.login_expanded
                    spacing: dp(6)
                    Label:
                        text: "登录在站点官方页面完成，App 不接触账号密码；cookies 只保存在本机，不会上传。需要登录的视频，不登录将无法下载。"
                        font_size: dp(11)
                        color: 0.65, 0.72, 0.84, 1
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                        size_hint_y: None
                        height: dp(58)
                    BoxLayout:
                        size_hint_y: None
                        height: dp(44)
                        spacing: dp(8)
                        GhostButton:
                            text: "站内登录"
                            height: dp(44)
                            on_release: app.open_login_webview()
                        GhostButton:
                            text: "导入 cookies.txt"
                            height: dp(44)
                            on_release: app.show_cookies_dialog()
                Label:
                    text: app.login_notice
                    size_hint_y: None
                    height: (dp(34) if app.login_notice else 0)
                    opacity: 1 if app.login_notice else 0
                    font_size: dp(11)
                    color: 0.95, 0.75, 0.4, 1
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

            Card:
                BoxLayout:
                    size_hint_y: None
                    height: dp(48)
                    spacing: dp(8)
                    PrimaryButton:
                        text: "下载选中"
                        on_release: app.start_download()
                    GhostButton:
                        text: "取消"
                        disabled: not app.busy
                        on_release: app.cancel_download()
                ProgressBar:
                    value: app.progress
                    max: 100
                    size_hint_y: None
                    height: dp(10)
                StatusLabel:
                    text: app.status
                BoxLayout:
                    size_hint_y: None
                    height: dp(38)
                    spacing: dp(8)
                    Label:
                        text: "保存目录：" + app.download_dir_text
                        font_size: dp(11)
                        color: 0.7, 0.76, 0.86, 1
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                        shorten: True
                        shorten_from: "center"
                    GhostButton:
                        text: "更改"
                        size_hint_x: None
                        width: dp(64)
                        height: dp(38)
                        on_release: app.choose_download_dir()
                BoxLayout:
                    size_hint_y: None
                    height: dp(40)
                    spacing: dp(8)
                    GhostButton:
                        text: "存储权限"
                        height: dp(40)
                        on_release: app.open_storage_settings()
                    GhostButton:
                        text: "服务日志"
                        height: dp(40)
                        on_release: app.show_service_log()
                    GhostButton:
                        text: "刷新目录"
                        height: dp(40)
                        on_release: app.refresh_download_dir()

            Card:
                SectionLabel:
                    text: "日志"
                ScrollView:
                    id: log_scroll
                    size_hint_y: None
                    height: dp(190)
                    do_scroll_x: False
                    Label:
                        text: app.log_text
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None
                        font_size: dp(11)
                        color: 0.72, 0.78, 0.88, 1
                        halign: "left"
                        valign: "top"
                GhostButton:
                    text: "复制日志"
                    height: dp(36)
                    on_release: app.copy_log()
